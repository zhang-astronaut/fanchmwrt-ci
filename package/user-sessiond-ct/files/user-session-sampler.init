#!/bin/sh /etc/rc.common
# Background session sampler — keep LuCI history warm without the page open.
START=98
USE_PROCD=1
BIN=/usr/bin/user-session-sampler.lua

start_service() {
	[ -f "$BIN" ] || return 1
	procd_open_instance user_session_sampler
	procd_set_param respawn 3600 5 5
	procd_set_param command /bin/sh -c "while true; do /usr/bin/lua $BIN >/dev/null 2>&1; sleep 5; done"
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall -f user-session-sampler.lua 2>/dev/null || true
}
