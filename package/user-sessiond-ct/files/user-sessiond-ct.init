#!/bin/sh /etc/rc.common
# Replace stock UserSession user_sessiond (reads empty fwx_user under TPROXY)
# with conntrack-based user-sessiond-ct. Procd on the app will respawn the
# same path, so we overwrite /fwx_root/usr/bin/user_sessiond.

START=99
USE_PROCD=1
BIN=/usr/bin/user-sessiond-ct
STOCK=/fwx_root/usr/bin/user_sessiond

start_service() {
	[ -x "$BIN" ] || return 1

	# overwrite vendor binary so UserSession procd instance runs ours
	if [ -d /fwx_root/usr/bin ]; then
		cp -f "$BIN" "$STOCK"
		chmod 755 "$STOCK"
	fi

	# stop any already-running stock process; procd may respawn our binary
	killall -9 user_sessiond 2>/dev/null || true
	sleep 1

	procd_open_instance user_sessiond_ct
	procd_set_param respawn 3600 5 5
	procd_set_param command "$BIN"
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall -9 user-sessiond-ct 2>/dev/null || true
	# do not leave the vendor binary broken if we overwrote it
}
